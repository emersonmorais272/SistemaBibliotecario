<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      prefHeight="500.0"
      prefWidth="600.0"
      spacing="18"
      style="-fx-background-color:#f6f7f4; -fx-padding:25;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.biblioteca.interfacebiblioteca.CadastrarUsuarioLoginController">

    <Label text="Cadastrar Novo Usuário"
           style="-fx-text-fill:#366511;">
        <font>
            <Font name="System Bold" size="20.0"/>
        </font>
    </Label>

    <GridPane alignment="CENTER" hgap="12" vgap="16">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="150.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="240.0"/>
        </columnConstraints>

        <Label text="Tipo de Usuário:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>

        <ComboBox fx:id="comboTipoUsuario"
                  prefWidth="220"
                  prefHeight="34"
                  style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#366511;"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"/>

        <Label text="Nome Completo:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

        <TextField fx:id="txtNome"
                   prefHeight="34"
                   style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="CPF (Apenas números):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>

        <TextField fx:id="txtCpf"
                   prefHeight="34"
                   style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Ano de Nascimento:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

        <TextField fx:id="txtAnoNascimento"
                   prefHeight="34"
                   style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <Label fx:id="lblCampo1"
               text="Matrícula:"
               visible="false"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="txtCampo1"
                   prefHeight="34"
                   visible="false"
                   style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

        <Label fx:id="lblCampo2"
               text="Curso:"
               visible="false"
               GridPane.columnIndex="0"
               GridPane.rowIndex="5"/>

        <TextField fx:id="txtCampo2"
                   prefHeight="34"
                   visible="false"
                   style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="5"/>

    </GridPane>

    <HBox alignment="CENTER" spacing="20">

        <Button mnemonicParsing="false"
                onAction="#salvarUsuario"
                text="Salvar Cadastro"
                prefWidth="170"
                prefHeight="36"
                style="-fx-background-color:#366511;
                       -fx-text-fill:white;
                       -fx-font-weight:bold;
                       -fx-background-radius:15;
                       -fx-padding:8 20;"/>

        <Button mnemonicParsing="false"
                onAction="#voltar"
                text="Cancelar e Voltar"
                prefWidth="170"
                prefHeight="36"
                style="-fx-background-color:#372650;
                       -fx-text-fill:white;
                       -fx-background-radius:15;
                       -fx-padding:8 20;"/>

    </HBox>

</VBox>