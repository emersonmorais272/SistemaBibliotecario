<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      prefHeight="450.0"
      prefWidth="500.0"
      spacing="18"
      style="-fx-background-color:#f6f7f4; -fx-padding:25;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.biblioteca.interfacebiblioteca.CadastrarFuncionarioLoginController">

    <Label text="Cadastro de Funcionário Administrativo"
           style="-fx-text-fill:#366511;">
        <font>
            <Font name="System Bold" size="20.0"/>
        </font>
    </Label>

    <GridPane alignment="CENTER" hgap="10" vgap="15">

        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="140.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0"/>
        </columnConstraints>

        <Label text="Nome Completo:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>

        <TextField fx:id="txtNome"
                   style="-fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="CPF (Apenas números):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

        <TextField fx:id="txtCpf"
                   style="-fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Ano de Nascimento:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>

        <TextField fx:id="txtAnoNascimento"
                   style="-fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="2"/>

        <Label text="Novo Cód. de Acesso:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

        <TextField fx:id="txtCodigoAcesso"
                   style="-fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#366511; -fx-padding:6;"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

    </GridPane>

    <HBox alignment="CENTER" spacing="20">

        <Button mnemonicParsing="false"
                onAction="#salvarFuncionario"
                text="Concluir Cadastro"
                style="-fx-background-color:#366511; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:15; -fx-padding:8 20;" />

        <Button mnemonicParsing="false"
                onAction="#voltar"
                text="Cancelar"
                style="-fx-background-color:#372650; -fx-text-fill:white; -fx-background-radius:15; -fx-padding:8 20;" />

    </HBox>

</VBox>