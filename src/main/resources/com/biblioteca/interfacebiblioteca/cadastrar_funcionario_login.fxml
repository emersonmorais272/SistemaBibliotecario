<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="500.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.interfacebiblioteca.CadastrarFuncionarioLoginController">

    <Label text="Cadastro de Funcionário Administrativo">
        <font>
            <Font name="System Bold" size="16.0" />
        </font>
    </Label>

    <GridPane alignment="CENTER" hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <Label text="Nome Completo:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtNome" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="CPF (Apenas números):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtCpf" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Ano de Nascimento:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtAnoNascimento" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Novo Cód. de Acesso:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtCodigoAcesso" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <HBox alignment="CENTER" spacing="20.0">
        <Button mnemonicParsing="false" onAction="#salvarFuncionario" text="Concluir Cadastro" style="-fx-font-weight: bold; -fx-text-fill: green;"/>
        <Button mnemonicParsing="false" onAction="#voltar" text="Cancelar" style="-fx-text-fill: red;"/>
    </HBox>

</VBox>
