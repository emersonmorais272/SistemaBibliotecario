<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="240.0" prefWidth="456.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.interfacebiblioteca.AtualizarCadastroController">
    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#e4e4e4" height="348.0" stroke="#e4e4e4" strokeType="INSIDE"
               width="550.0"/>

    <Button fx:id="btnCabcelar" layoutX="308.0" layoutY="290.0" mnemonicParsing="false" onAction="#voltar"
            prefHeight="34.0" prefWidth="91.0" text="Cancelar" textFill="RED">
        <font>
        <Font name="System Bold" size="16.0"/>
        </font>
    </Button>

    <GridPane layoutX="50.0" layoutY="48.0" prefHeight="242.0" prefWidth="450.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="252.6" minWidth="10.0" prefWidth="117.19999999999999"/>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="332.6" minWidth="10.0" prefWidth="332.6"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints maxHeight="60.4" minHeight="10.0" prefHeight="60.4" vgrow="SOMETIMES"/>
            <RowConstraints maxHeight="60.4" minHeight="10.0" prefHeight="60.4" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>
        <children>
            <TextField fx:id="txtNome" prefHeight="23.0" prefWidth="318.0" GridPane.columnIndex="1"/>
            <TextField fx:id="txtAno" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <TextField fx:id="txtMatricula" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <TextField fx:id="txtCurso" layoutX="127.0" layoutY="146.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Nome:" GridPane.halignment="RIGHT"
                  GridPane.valignment="CENTER"/>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Ano de Nascimento:" GridPane.halignment="RIGHT"
                  GridPane.rowIndex="1"/>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Matricula:" GridPane.halignment="RIGHT"
                  GridPane.rowIndex="2"/>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Curso:" GridPane.halignment="RIGHT"
                  GridPane.rowIndex="3"/>
        </children>
    </GridPane>

    <Text layoutX="175.0" layoutY="39.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Atualizar Cadastro">
        <font>
            <Font name="System Bold" size="23.0"/>
        </font>
    </Text>
    <Button fx:id="btnAtualizar" layoutX="155.0" layoutY="290.0" mnemonicParsing="false" onAction="#atualizar"
            prefHeight="34.0" prefWidth="91.0" text="Atualizar" textFill="#39bf00">
        <font>
          <Font name="System Bold" size="16.0"/>
        </font>
    </Button>
</AnchorPane>
