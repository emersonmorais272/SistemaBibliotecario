<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.biblioteca.interfacebiblioteca.LoginController">

    <Label text="Login do Sistema" />

    <TextField fx:id="txtUsuario" promptText="Usuário"/>
    <PasswordField fx:id="txtSenha" promptText="Senha"/>

    <Button text="Entrar" onAction="#entrar"/>

</VBox>