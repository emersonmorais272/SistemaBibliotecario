<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="650.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.interfacebiblioteca.SolicitarEmprestimoController">

    <Label text="Acervo Disponível para Empréstimo">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <TableView fx:id="tabelaAcervo" prefHeight="300.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
            <TableColumn fx:id="colTitulo" prefWidth="250.0" text="Título" />
            <TableColumn fx:id="colAutor" prefWidth="150.0" text="Autor" />
            <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="20.0">
        <Button mnemonicParsing="false" onAction="#confirmarEmprestimo" text="Confirmar Empréstimo" style="-fx-font-weight: bold; -fx-text-fill: green;"/>
        <Button mnemonicParsing="false" onAction="#voltar" text="Voltar ao Menu" />
    </HBox>

</VBox>
