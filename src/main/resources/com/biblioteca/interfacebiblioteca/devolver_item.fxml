<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.interfacebiblioteca.DevolverItemController">

    <Label text="Devolver Empréstimo">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <TableView fx:id="tabelaEmprestimos" prefHeight="250.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="colTitulo" prefWidth="300.0" text="Livro / Artigo" />
            <TableColumn fx:id="colDataDev" prefWidth="200.0" text="Data Prevista de Devolução" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="20.0">
        <Button mnemonicParsing="false" onAction="#confirmarDevolucao" text="Confirmar Devolução" style="-fx-font-weight: bold; -fx-text-fill: #b22222;"/>
        <Button mnemonicParsing="false" onAction="#voltar" text="Voltar ao Menu" />
    </HBox>

</VBox>
