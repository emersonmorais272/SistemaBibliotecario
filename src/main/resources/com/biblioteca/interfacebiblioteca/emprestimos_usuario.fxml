<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="650.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.biblioteca.interfacebiblioteca.EmprestimosUsuarioController">

    <Label fx:id="lblTitulo" text="Empréstimos do Usuário">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <TableView fx:id="tabelaEmprestimos" prefHeight="300.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="colTitulo" prefWidth="200.0" text="Livro / Artigo" />
            <TableColumn fx:id="colDataEmp" prefWidth="130.0" text="Data do Empréstimo" />
            <TableColumn fx:id="colDataDev" prefWidth="130.0" text="Data de Devolução" />
            <TableColumn fx:id="colMulta" prefWidth="120.0" text="Multa Atual" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="20.0">
        <Button mnemonicParsing="false" onAction="#perdoarMulta" text="Perdoar Multa do Item" style="-fx-font-weight: bold; -fx-text-fill: green;"/>
        <Button mnemonicParsing="false" onAction="#voltar" text="Voltar para Usuários" />
    </HBox>

</VBox>
